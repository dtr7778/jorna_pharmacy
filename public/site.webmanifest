{
  "name": "Jorna Pharmacy",
  "short_name": "Jorna Pharmacy",
  "description": "Jorna Pharmacy's data management system for tracking sales, expenses, inventory, and reports — all in one secure web app.",
  "start_url": "/",
  "scope": "/",
  "lang": "en-US",
  "dir": "ltr",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#006045",
  "categories": ["business", "productivity", "utilities"],
  "prefer_related_applications": false,
  "display": "standalone",
  "screenshots": [],
  "shortcuts": [],
  "icons": [
